# .env.example
# Copy file này thành .env và điền giá trị thực tế

# Security Keys - PHẢI KHỚP giữa server, ESP32, và dashboard
# ESP32 devices sử dụng key này khi gửi register_device
ESP32_API_KEY=esp32_secret_key_2024_buoi7

# Dashboard/Web client sử dụng key này khi gửi register_web
DASHBOARD_API_KEY=dashboard_secret_key_2024_buoi7

# Server port
PORT=3000

# ============================================================
# HƯỚNG DẪN:
# 1. Sao chép file này thành .env
# 2. Sửa các giá trị nếu cần
# 3. Đảm bảo keys khớp giữa:
#    - .env (server)
#    - components/esp32_telemetry.ino (API_KEY)
#    - web/index.html (dashboard default key)
# 4. KHÔNG commit file .env lên Git!
# ============================================================
